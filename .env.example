# ============================================================================
# AgendaLudoia - Configuración de Entorno & SMTP Resend (Supabase Auth)
# ============================================================================

# Supabase Cloud Database URL (Pooler de Transacciones o Conexión Directa)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Frontend Supabase Credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Puertos locales del backend
GRPC_PORT=50051
APP_ENV=development

# ----------------------------------------------------------------------------
# GUÍA DE CONFIGURACIÓN SMTP REAL EN SUPABASE AUTH (RESEND INTEGRATION)
# ----------------------------------------------------------------------------
# Para enviar Magic Links sin caer en límites ni marcas de Spam, configura los
# siguientes parámetros en Supabase Dashboard > Authentication > Provider Settings > Custom SMTP:
#
# Enable Custom SMTP: Enabled
# Sender email: onboarding@resend.dev (o tu dominio verificado en Resend)
# Sender name: AgendaLudoia Notifications
# Host: smtp.resend.com
# Port: 465 (SSL) o 587 (TLS)
# Username: resend
# Password: [TU_RESEND_API_KEY_re_123456789]
# ----------------------------------------------------------------------------
