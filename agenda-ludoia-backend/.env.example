# Supabase Cloud Database URL (Direct connection / Transaction Pooler connection)
# Formato: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# O conexión directa en puerto 5432: postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Puertos locales del backend
GRPC_PORT=50051
APP_ENV=development
